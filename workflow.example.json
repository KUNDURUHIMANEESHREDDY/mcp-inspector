{
  "name": "echo-then-concat",
  "steps": [
    {
      "id": "source",
      "tool": "echo",
      "arguments": { "message": "stateful-workflow" }
    },
    {
      "id": "combine",
      "tool": "concat",
      "arguments": {
        "left": { "$ref": "source#/structuredContent/echo" },
        "right": "-verified"
      }
    }
  ]
}

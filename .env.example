# Optional OTLP/HTTP trace exporter endpoint. Leave empty to disable export.
# Example: http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=mcp-inspector

# Optional bearer credential for the configured HTTP upstream. Never commit a real value.
# MCP_INSPECTOR_UPSTREAM_BEARER_TOKEN=

# Exact canonical browser Origin allowlist for non-loopback proxy binds.
# Required with MCP_INSPECTOR_PROXY_BEARER_TOKEN when --allow-remote is used.
# MCP_INSPECTOR_ALLOWED_ORIGINS=https://your-console.example

# Shared client bearer token for non-loopback proxy binds (minimum 32 characters).
# This is defense-in-depth, not per-user identity; keep the listener behind a TLS gateway.
# MCP_INSPECTOR_PROXY_BEARER_TOKEN=

# Upstream inactivity timeout, default 120000 (2 minutes).
# MCP_INSPECTOR_UPSTREAM_TIMEOUT_MS=120000

# Maximum JSON-RPC/SSE payload size observed in memory, default 16777216 (16 MiB).
# MCP_INSPECTOR_MAX_FRAME_BYTES=16777216

# Maximum raw HTTP request body forwarded upstream (1 KiB–64 MiB; default 16 MiB).
# MCP_INSPECTOR_MAX_REQUEST_BYTES=16777216

# debug|info|warn|error; default info.
# MCP_INSPECTOR_LOG_LEVEL=info

# Correlation state limits for long-running proxies.
# MCP_INSPECTOR_RPC_TIMEOUT_MS=120000
# MCP_INSPECTOR_MAX_PENDING_REQUESTS=10000
# Legacy Streamable HTTP session idle expiry (60,000-86,400,000 ms; default 30 min).
# MCP_INSPECTOR_SESSION_IDLE_MS=1800000

# Optional exact hostname/IP allowlist for explicitly trusted private upstreams.
# Unlisted upstream DNS names that resolve to private/reserved addresses are blocked.
# MCP_INSPECTOR_ALLOWED_UPSTREAM_HOSTS=internal-mcp.example,192.168.1.20

# Optional static upstream header map encoded as a JSON object. Never commit real secrets.
# Do not include Host, Content-Length, hop-by-hop headers, or duplicate names.
# MCP_INSPECTOR_UPSTREAM_HEADERS={"x-api-key":"replace-me","x-tenant":"dev"}
